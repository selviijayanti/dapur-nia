rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi Menu Dapur Nia (Sesuai Bab 4.6 & Bab 5.2 Modul Sesi 4)
    match /menus/{menuId} {
      // Semua orang (termasuk tamu) boleh melihat menu
      allow read: if true;
      
      // Menambah: sudah masuk (auth != null), pemilikId = uid dirinya, harga > 0
      allow create: if request.auth != null
        && request.resource.data.pemilikId == request.auth.uid
        && request.resource.data.harga is number
        && request.resource.data.harga > 0;
        
      // Mengubah dan menghapus: hanya pembuatnya (atau data awal sesi latihan tanpa pemilikId)
      allow update, delete: if request.auth != null
        && (resource.data.pemilikId == request.auth.uid || !('pemilikId' in resource.data));
    }
    
    // Koleksi Pelanggan Dapur Nia (Hanya pengguna masuk)
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }
    
    // Koleksi Pesanan Dapur Nia
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
